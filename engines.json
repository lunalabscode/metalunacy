{
  "engines": {
    "ollama": {
      "versions": [
        {
          "version": "v0.30.5",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "gguf", "label": "GGUF" },
            { "id": "kquants", "label": "KQuants" },
            { "id": "hybrid-exec", "label": "Hybrid Execution" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/ollama/ollama",
          "buildTool": "go",
          "buildCommand": "go build .",
          "buildPreCommand": "go generate ./...",
          "buildDependencies": {
            "default": ["git", "cmake", "go"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk"],
            "arch": ["go", "cmake", "gcc", "git"],
            "ubuntu": ["golang-go", "cmake", "build-essential", "git"]
          },
          "buildFlags": [
            { "id": "ollama_llama_backends", "label": "Ollama Llama Backends", "makeFlag": "OLLAMA_LLAMA_BACKENDS=cuda_v13" },
            { "id": "cuda_architectures", "label": "CUDA Architectures", "makeFlag": "-DCMAKE_CUDA_ARCHITECTURES=native" },
            { "id": "custom_cpu_defs", "label": "Custom CPU Definitions", "makeFlag": "OLLAMA_CUSTOM_CPU_DEFS=-DLLAMA_AVX2=on" }
          ]
        }
      ]
    },
    "llamacpp": {
      "versions": [
        {
          "version": "b9543",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "gguf", "label": "GGUF" },
            { "id": "kquants", "label": "KQuants" },
            { "id": "hybrid-exec", "label": "Hybrid Execution" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/ggerganov/llama.cpp",
          "buildTool": "cmake",
          "buildCommand": "cmake --build build --config Release",
          "buildPreCommand": "cmake -B build -DCMAKE_BUILD_TYPE=Release",
          "buildDependencies": {
            "default": ["git", "cmake", "build-essential"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk", "hipblas"],
            "arch": ["cmake", "gcc", "git", "openblas"],
            "ubuntu": ["cmake", "build-essential", "git", "libopenblas-dev"]
          },
          "buildFlags": [
            { "id": "ggml_cuda", "label": "GGML CUDA", "makeFlag": "-DGGML_CUDA=ON" },
            { "id": "ggml_avx2", "label": "GGML AVX2", "makeFlag": "-DGGML_AVX2=ON" },
            { "id": "ggml_fma", "label": "GGML FMA", "makeFlag": "-DGGML_FMA=ON" },
            { "id": "ggml_metal", "label": "GGML Metal", "makeFlag": "-DGGML_METAL=ON" }
          ]
        },
        {
          "label": "TheTom llama-cpp-turboquant",
          "url": "https://github.com/TheTom/llama-cpp-turboquant",
          "buildTool": "cmake",
          "buildCommand": "cmake --build build --config Release",
          "buildPreCommand": "cmake -B build -DCMAKE_BUILD_TYPE=Release",
          "buildDependencies": {
            "default": ["git", "cmake", "build-essential"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk"],
            "arch": ["cmake", "gcc", "git"],
            "ubuntu": ["cmake", "build-essential", "git"]
          },
          "buildFlags": [
            { "id": "ggml_cuda", "label": "GGML CUDA", "makeFlag": "-DGGML_CUDA=ON" },
            { "id": "ggml_avx2", "label": "GGML AVX2", "makeFlag": "-DGGML_AVX2=ON" },
            { "id": "ggml_fma", "label": "GGML FMA", "makeFlag": "-DGGML_FMA=ON" },
            { "id": "ggml_metal", "label": "GGML Metal", "makeFlag": "-DGGML_METAL=ON" }
          ]
        }
      ]
    },
    "vllm": {
      "versions": [
        {
          "version": "v0.22.1",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "optimized-concurrency", "label": "Optimized Multi-User Concurrency" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/vllm-project/vllm",
          "buildTool": "pip",
          "buildCommand": "pip install -e .",
          "buildPreCommand": "pip install -r requirements-build.txt",
          "buildDependencies": {
            "default": ["git", "python3", "python3-pip"],
            "nvidia": ["cuda-toolkit", "libcudnn8"],
            "amd": ["rocm-hip-sdk", "miopen-hip"],
            "arch": ["python", "python-pip", "git", "gcc"],
            "ubuntu": ["python3", "python3-pip", "git", "build-essential"]
          },
          "buildFlags": [
            { "id": "target_device", "label": "Target Device", "makeFlag": "VLLM_TARGET_DEVICE=cuda" },
            { "id": "max_jobs", "label": "Max Jobs", "makeFlag": "MAX_JOBS=4" },
            { "id": "nvcc_flags", "label": "NVCC Flags", "makeFlag": "NVCC_FLAGS=--threads 4" }
          ]
        }
      ]
    }
  }
}