{
  "engines": {
    "ollama": {
      "versions": [
        {
          "version": "v0.30.5",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "gguf", "label": "GGUF" },
            { "id": "kquants", "label": "KQuants" },
            { "id": "hybrid-exec", "label": "Hybrid Execution" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/ollama/ollama",
          "buildTool": "go",
          "buildCommand": "go build .",
          "buildPreCommand": "go generate ./...",
          "buildDependencies": {
            "default": ["git", "cmake", "go"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk"],
            "arch": ["go", "cmake", "gcc", "git"],
            "ubuntu": ["golang-go", "cmake", "build-essential", "git"]
          },
          "buildFlags": {
            "default": [
              { "id": "custom_cpu_defs", "label": "Custom CPU Definitions", "type": "env", "key": "OLLAMA_CUSTOM_CPU_DEFS", "value": "-DLLAMA_AVX2=on" }
            ],
            "nvidia": [
              { "id": "ollama_llama_backends", "label": "Ollama Llama Backends", "type": "env", "key": "OLLAMA_LLAMA_BACKENDS", "value": "cuda_v13" },
              { "id": "cuda_architectures", "label": "CUDA Architectures", "type": "env", "key": "CMAKE_CUDA_ARCHITECTURES", "value": "native" }
            ],
            "amd": [
              { "id": "ollama_llama_backends", "label": "Ollama Llama Backends", "type": "env", "key": "OLLAMA_LLAMA_BACKENDS", "value": "rocm_v7_2" },
              { "id": "hip_architectures", "label": "HIP Architectures", "type": "env", "key": "CMAKE_HIP_ARCHITECTURES", "value": "native" }
            ]
          }
        }
      ]
    },
    "llamacpp": {
      "versions": [
        {
          "version": "b9543",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "gguf", "label": "GGUF" },
            { "id": "kquants", "label": "KQuants" },
            { "id": "hybrid-exec", "label": "Hybrid Execution" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/ggerganov/llama.cpp",
          "buildTool": "cmake",
          "buildCommand": "cmake --build build --config Release",
          "buildPreCommand": "cmake -B build -DCMAKE_BUILD_TYPE=Release",
          "buildDependencies": {
            "default": ["git", "cmake"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk", "hipblas"],
            "arch": ["cmake", "gcc", "git", "openblas"],
            "ubuntu": ["cmake", "build-essential", "git", "libopenblas-dev"]
          },
          "buildFlags": {
            "default": [
              { "id": "ggml_avx2", "label": "GGML AVX2", "type": "parameter", "key": "-DGGML_AVX2", "value": "ON" },
              { "id": "ggml_fma", "label": "GGML FMA", "type": "parameter", "key": "-DGGML_FMA", "value": "ON" }
            ],
            "nvidia": [
              { "id": "ggml_cuda", "label": "GGML CUDA", "type": "parameter", "key": "-DGGML_CUDA", "value": "ON" },
              { "id": "cuda_architectures", "label": "CUDA Architectures", "type": "parameter", "key": "-DCMAKE_CUDA_ARCHITECTURES", "value": "all" }
            ],
            "amd": [
              { "id": "ggml_hipblas", "label": "GGML HIPBLAS", "type": "parameter", "key": "-DGGML_HIPBLAS", "value": "ON" },
              { "id": "hip_architectures", "label": "HIP Architectures", "type": "parameter", "key": "-DCMAKE_HIP_ARCHITECTURES", "value": "native" }
            ]
          }
        },
        {
          "label": "TheTom llama-cpp-turboquant",
          "url": "https://github.com/TheTom/llama-cpp-turboquant",
          "buildTool": "cmake",
          "buildCommand": "cmake --build build --config Release",
          "buildPreCommand": "cmake -B build -DCMAKE_BUILD_TYPE=Release",
          "buildDependencies": {
            "default": ["git", "cmake"],
            "nvidia": ["cuda-toolkit"],
            "amd": ["rocm-hip-sdk"],
            "arch": ["cmake", "gcc", "git"],
            "ubuntu": ["cmake", "build-essential", "git"]
          },
          "buildFlags": {
            "default": [
              { "id": "ggml_avx2", "label": "GGML AVX2", "type": "parameter", "key": "-DGGML_AVX2", "value": "ON" }
            ],
            "nvidia": [
              { "id": "ggml_cuda", "label": "GGML CUDA", "type": "parameter", "key": "-DGGML_CUDA", "value": "ON" }
            ],
            "amd": [
              { "id": "ggml_hipblas", "label": "GGML HIPBLAS", "type": "parameter", "key": "-DGGML_HIPBLAS", "value": "ON" }
            ]
          }
        }
      ]
    },
    "vllm": {
      "versions": [
        {
          "version": "v0.22.1",
          "features": [
            { "id": "parallel_computing", "label": "Parallel Computing" },
            { "id": "optimized-concurrency", "label": "Optimized Multi-User Concurrency" }
          ]
        }
      ],
      "repositories": [
        {
          "label": "Official Github",
          "url": "https://github.com/vllm-project/vllm",
          "buildTool": "pip",
          "buildCommand": "pip install -e .",
          "buildPreCommand": "pip install -r requirements-build.txt",
          "buildDependencies": {
            "default": ["git", "python3", "python3-pip"],
            "nvidia": ["cuda-toolkit", "libcudnn8"],
            "amd": ["rocm-hip-sdk", "miopen-hip"],
            "arch": ["python", "python-pip", "git", "gcc"],
            "ubuntu": ["python3", "python3-pip", "git", "build-essential"]
          },
          "buildFlags": {
            "default": [
              { "id": "max_jobs", "label": "Max Jobs", "type": "env", "key": "MAX_JOBS", "value": "4" }
            ],
            "nvidia": [
              { "id": "target_device", "label": "Target Device", "type": "env", "key": "VLLM_TARGET_DEVICE", "value": "cuda" },
              { "id": "nvcc_flags", "label": "NVCC Flags", "type": "env", "key": "NVCC_FLAGS", "value": "--threads 4" }
            ],
            "amd": [
              { "id": "target_device", "label": "Target Device", "type": "env", "key": "VLLM_TARGET_DEVICE", "value": "rocm" }
            ]
          }
        }
      ]
    }
  }
}