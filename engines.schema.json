{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLMVersions",
  "type": "object",
  "properties": {
    "engines": {
      "type": "object",
      "properties": {
        "ollama": { "$ref": "#/definitions/engineData" },
        "llamacpp": { "$ref": "#/definitions/engineData" },
        "vllm": { "$ref": "#/definitions/engineData" }
      },
      "required": ["ollama", "llamacpp", "vllm"],
      "additionalProperties": false
    }
  },
  "required": ["engines"],
  "additionalProperties": false,
  "definitions": {
    "engineData": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": { "type": "string" },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" }
                  },
                  "required": ["id", "label"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["version", "features"],
            "additionalProperties": false
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "buildTool": { "type": "string" },
              "buildDependencies": {
                "type": "array",
                "items": { "type": "string" }
              },
              "buildFlags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "makeFlag": { "type": "string" }
                  },
                  "required": ["id", "label", "makeFlag"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["url", "buildTool", "buildDependencies", "buildFlags"],
            "additionalProperties": false
          }
        }
      },
      "required": ["versions", "repositories"],
      "additionalProperties": false
    }
  }
}